Table certificate_type {
  id int [pk]
  name varchar(255) [not null]
  enabled boolean [not null]
}

Table certificate_template {
  id int [pk]
  id_certificate_type int [not null]
  version varchar(50) [not null]
  status varchar(50) [not null]
  storage_reference varchar(255) [not null]
  activated_at datetime
}

Table certificate_request {
  id int [pk]
  student_id varchar(255) [not null]
  id_certificate_type int [not null]
  id_template int
  processing_route varchar(50) [not null]
  status varchar(50) [not null]
  manual_routing_reason varchar(100)
  created_at datetime [not null]
  completed_at datetime
}

Table certificate_document {
  id int [pk]
  id_request int [not null, unique]
  storage_reference varchar(255) [not null]
  issued_at datetime [not null]
}

Ref: "certificate_template"."id_certificate_type" > "certificate_type"."id"

Ref: "certificate_request"."id_certificate_type" > "certificate_type"."id"

Ref: "certificate_request"."id_template" >? "certificate_template"."id"

Ref: "certificate_document"."id_request" - "certificate_request"."id"
